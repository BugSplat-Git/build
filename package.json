{
  "name": "@bugsplat/build",
  "version": "0.1.0",
  "description": "Build-tool plugins that give every JavaScript file and its source map a debug ID and upload the source maps to BugSplat",
  "keywords": [
    "bugsplat",
    "crash",
    "reporting",
    "source map",
    "sourcemap",
    "debug id",
    "vite",
    "rollup",
    "webpack",
    "plugin"
  ],
  "homepage": "https://www.bugsplat.com",
  "license": "MIT",
  "author": "BugSplat",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/esm/vite.d.ts",
        "default": "./dist/esm/vite.js"
      },
      "require": {
        "types": "./dist/cjs/vite.d.ts",
        "default": "./dist/cjs/vite.js"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/esm/rollup.d.ts",
        "default": "./dist/esm/rollup.js"
      },
      "require": {
        "types": "./dist/cjs/rollup.d.ts",
        "default": "./dist/cjs/rollup.js"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/esm/webpack.d.ts",
        "default": "./dist/esm/webpack.js"
      },
      "require": {
        "types": "./dist/cjs/webpack.d.ts",
        "default": "./dist/cjs/webpack.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-commonjs.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "node scripts/check-dist.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "magic-string": "^1.4.5"
  },
  "peerDependencies": {
    "rollup": "^4.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^24.19.2",
    "rollup": "^4.68.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite6": "npm:vite@^6.4.6",
    "vite7": "npm:vite@^7.3.8",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2"
  }
}
